# Copy to .env and set secrets locally. Never commit .env.
SQLALCHEMY_DATABASE_URI=mssql+pyodbc://YLH:YLH@127.0.0.1:1433/Hospital_data?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# Use a long random value before allowing phone / LAN access.
WEB_SECRET_KEY=

# Set to 1 only when a local HTTPS reverse proxy forwards to 127.0.0.1:5000.
WEB_BEHIND_HTTPS_PROXY=0
