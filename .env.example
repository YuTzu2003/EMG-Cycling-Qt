# Copy to .env and set secrets locally. Never commit .env.
DB_SERVER=127.0.0.1,1433
DB_NAME=RehabPatients-ylh
DB_USER=Rehab-User
DB_PASSWORD=

# Use long random values. Required before allowing phone / LAN access.
WEB_PASSWORD=
WEB_SECRET_KEY=

# Set to 1 only when a local HTTPS reverse proxy forwards to 127.0.0.1:5000.
WEB_BEHIND_HTTPS_PROXY=0
